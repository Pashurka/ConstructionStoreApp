<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConstructionStoreApp.Views.AboutPage"
             xmlns:vm="clr-namespace:ConstructionStoreApp.ViewModels"
             Title="Магазин будівельних матеріалів">

    <ContentPage.BindingContext>
        <vm:AboutViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Accent">#96d1ff</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackLayout BackgroundColor="{StaticResource Accent}" VerticalOptions="FillAndExpand" HorizontalOptions="Fill">
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center">
                <ContentView Padding="0,40,0,40" VerticalOptions="FillAndExpand">
                    <Image Source="icon_store.png" VerticalOptions="Center" HeightRequest="300" />
                </ContentView>
            </StackLayout>
        </StackLayout>
        <ScrollView Grid.Row="1">
            <StackLayout Orientation="Vertical" Padding="30,24,30,24" Spacing="10">
                <Label Text="Android-застосунок розроблено під час виконання бакалаврської роботи." FontSize="16" Padding="0,0,0,0"/>
                <Label Text="Виконавець - Чередниченко Дмитрий Олегович." FontSize="16" Padding="0,0,0,0"/>
                <Image Source="icon_fcit.png" VerticalOptions="Center" HeightRequest="180" />
                <Button Text="Кафедра інформаційних технологій"
                        Clicked="OnButtonClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="Blue" />
            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>