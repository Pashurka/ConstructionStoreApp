<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConstructionStoreApp.Views.CartPage"
             Title="Кошик">
    <ContentPage.Content>
        <StackLayout>
            <!-- Header with total -->
            <Frame BackgroundColor="#f8f9fa" CornerRadius="0" Padding="15">
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                    <Label Text="Всього: " FontSize="Medium"/>
                    <Label Text="4263.40 грн" FontSize="Medium" FontAttributes="Bold" TextColor="Green"/>
                </StackLayout>
            </Frame>

            <!-- Cart items -->
            <ScrollView>
                <StackLayout Padding="10" Spacing="15">
                    <!-- Item 1 - Kitchen countertop -->
                    <Frame BorderColor="LightGray" CornerRadius="5" Padding="10">
                        <StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Image Source="kitchen_countertop.jpg" WidthRequest="60" HeightRequest="60" Aspect="AspectFill"/>
                                <StackLayout>
                                    <Label Text="Стільниця кухонна" FontAttributes="Bold"/>
                                    <Label Text="1200.00 грн" TextColor="Green"/>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" HorizontalOptions="End" Spacing="15">
                                <Label Text="3 шт." FontSize="Small"/>
                                <Label Text="3600.00 грн" FontSize="Small" FontAttributes="Bold"/>
                                <Button Text="✕" TextColor="Red" BackgroundColor="Transparent" 
                                        HorizontalOptions="End" WidthRequest="30" HeightRequest="30"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <!-- Item 2 - MDF front -->
                    <Frame BorderColor="LightGray" CornerRadius="5" Padding="10">
                        <StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Image Source="mdf_front.jpg" WidthRequest="60" HeightRequest="60" Aspect="AspectFill"/>
                                <StackLayout>
                                    <Label Text="Фасад MDF" FontAttributes="Bold"/>
                                    <Label Text="320.40 грн" TextColor="Green"/>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" HorizontalOptions="End" Spacing="15">
                                <Label Text="1 шт." FontSize="Small"/>
                                <Label Text="320.40 грн" FontSize="Small" FontAttributes="Bold"/>
                                <Button Text="✕" TextColor="Red" BackgroundColor="Transparent" 
                                        HorizontalOptions="End" WidthRequest="30" HeightRequest="30"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <!-- Item 3 - Furniture legs -->
                    <Frame BorderColor="LightGray" CornerRadius="5" Padding="10">
                        <StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Image Source="furniture_leg.jpg" WidthRequest="60" HeightRequest="60" Aspect="AspectFill"/>
                                <StackLayout>
                                    <Label Text="Ніжка меблева" FontAttributes="Bold"/>
                                    <Label Text="85.75 грн" TextColor="Green"/>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" HorizontalOptions="End" Spacing="15">
                                <Label Text="4 шт." FontSize="Small"/>
                                <Label Text="343.00 грн" FontSize="Small" FontAttributes="Bold"/>
                                <Button Text="✕" TextColor="Red" BackgroundColor="Transparent" 
                                        HorizontalOptions="End" WidthRequest="30" HeightRequest="30"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </ScrollView>

            <!-- Checkout button -->
            <Button Text="Оформити замовлення" 
                    BackgroundColor="#007bff" 
                    TextColor="White" 
                    Margin="20" 
                    CornerRadius="5"
                    HeightRequest="50"
                    FontAttributes="Bold"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>